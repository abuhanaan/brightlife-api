<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="http://maven.apache.org/POM/4.0.0"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <artifactId>api-contract</artifactId>
  <build>
    <plugins>
      <plugin>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <executions>
          <execution>
            <configuration>
              <apiPackage>
                com.fronteers.brightlife.api
              </apiPackage>

              <configOptions>
                <dateLibrary>java8</dateLibrary>
                <delegatePattern>false</delegatePattern>
                <documentationProvider>springdoc</documentationProvider>
                <interfaceOnly>true</interfaceOnly>
                <library>spring-boot</library>
                <sourceFolder>src/gen/java/main</sourceFolder>
                <useJakartaEe>true</useJakartaEe>
                <useSpringBoot3>true</useSpringBoot3>
                <useSwaggerUI>true</useSwaggerUI>
                <useTags>true</useTags>
              </configOptions>
              <generatorName>spring</generatorName>
              <inputSpec>
                ${project.basedir}/src/main/resources/static/brightlife_api_contract.yaml
              </inputSpec>
              <modelPackage>
                com.fronteers.brightlife.model
              </modelPackage>
              <packageName>
                com.fronteers.brightlife
              </packageName>
            </configuration>
            <goals>
              <goal>generate</goal>
            </goals>
          </execution>
        </executions>
        <groupId>org.openapitools</groupId>
        <version>6.6.0</version>
      </plugin>


      <!--            To generate a single open api specification file-->

      <plugin>
        <artifactId>swagger-codegen-maven-plugin</artifactId>
        <executions>
          <execution>
            <configuration>
              <configOptions>
                <!-- Default output file name is 'openapi.yaml'
                or 'openapi.json'. But you can change
                                 the name by <outputFile>myapi.yaml</outputFile> -->
                <outputFile>${project.name}.yaml</outputFile>
              </configOptions>

              <!-- Use 'openapi-yaml' to get resolved YAML or
              'openapi' to get resolved JSON -->
              <inputSpec>
                ${project.basedir}/src/main/resources/static/brightlife_api_contract.yaml
              </inputSpec>

              <!-- Default is
              ${project.build.directory}/generated-sources/swagger -->
              <language>openapi-yaml</language>

              <output>${project.build.directory}/classes/static</output>
            </configuration>
            <goals>
              <goal>generate</goal>
            </goals>
            <phase>process-resources</phase>
          </execution>
        </executions>
        <groupId>io.swagger.codegen.v3</groupId>
        <version>3.0.33</version>
      </plugin>

      <!--            To delete some files which are not required-->
      <plugin>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <configuration>
              <target>
                <delete file="${project.basedir}/target/classes/static/README.md"/>
                <delete file="${project.basedir}/target/classes/static/.swagger-codegen-ignore"/>
                <delete file="${project.basedir}/target/classes/static/openapi.yaml"/>
                <delete dir="${project.basedir}/target/classes/static/.swagger-codegen"/>
                <delete dir="${project.basedir}/target/classes/static/schemas"/>
              </target>
            </configuration>
            <goals>
              <goal>run</goal>
            </goals>
            <phase>process-resources</phase>
          </execution>
        </executions>
        <groupId>org.apache.maven.plugins</groupId>
        <version>3.1.0</version>
      </plugin>
    </plugins>
  </build>

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <artifactId>brighlife-api-contract</artifactId>
    <groupId>com.fronteers</groupId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

</project>